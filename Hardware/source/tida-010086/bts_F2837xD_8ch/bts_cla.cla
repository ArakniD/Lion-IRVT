/*
 * bts_cla.cla
 *
 * CLA1 Task 1: single-pole IIR filter over the F2837xD internal ADC's cell
 * voltage and cell current channels.
 *
 * WHY THIS EXISTS
 * ---------------
 * The internal ADC runs at 99.67 kSPS - 1:1 with EPWM1's switching period,
 * since the SOC event prescaler went to 1 (EPWM1 TBPRD 902 at EPWMCLK
 * 90 MHz; see the derivation in bts_cla_shared.h).
 *
 * THIS TASK IS WHY THAT RATE IS AFFORDABLE. The C28x is not in the fast path
 * at all: ADCA INT1 is armed in the ADC but masked in the PIE, so there is no
 * interrupt every 10.03 us on a core already running eight control loops off
 * the ADS131M08 DRDY interrupts. The CLA consumes every sweep and the C28x
 * reads the result at 10 Hz in C1().
 *
 * It replaced adcCellVoltageISR, which stored each sample into an 8-deep ring
 * that BTS_monitor_Iout_Vout averaged at 10 Hz - so telemetry reported a
 * 1.2 ms snapshot taken once every 100 ms, discarding 98.8% of the samples
 * and aliasing whatever ripple sat inside that window. This task folds EVERY
 * sample into two running averages instead. It costs the C28x nothing - the CLA is a separate
 * processor with its own bus to the ADC result registers.
 *
 * TELEMETRY ONLY
 * --------------
 * TWO OUTPUTS, FOR TWO CONSUMERS WITH OPPOSITE REQUIREMENTS.
 *
 * The 20 Hz pair (...Filt) is telemetry and may lag - ~37 ms to settle,
 * against a 100 ms reporting period.
 *
 * The fast pair (...Fast) is what the protection path reads, and it is tuned
 * to settle in ~184 us, matching the 8-sample ring it replaced. The reverse
 * polarity check, group supervision and BTS_cellVoltageAsCtrl16b() take this
 * one. They are faster now than they were: the ring spanned 1204 us at the
 * old rate and was only re-read once per 100 ms telemetry pass.
 *
 * THE OVER-CURRENT TRIPS DO NOT READ EITHER OF THESE. They run off the
 * ADS131M08 in BTS_tripEpwm() and off the CMPSS comparators in hardware,
 * neither of which involves this task.
 *
 * TRIGGER
 * -------
 * ADCA INT2, sourced from ADCA SOC6 (the A0 reference channel, last in the
 * EPWM1 SOCA sweep) and routed by CLA1TASKSRCSEL1. Taking the trigger at the
 * tail of the sweep guarantees all seventeen result registers hold this
 * period's conversions. ADCA INT2 is in continuous mode and its PIE channel
 * is masked - see the long note in BTS_HAL_setupADC().
 *
 * DATA
 * ----
 * Every object shared with the C28x is defined in bts_cla_data.c and only
 * declared in bts_cla_shared.h. That is a toolchain constraint, not a style
 * choice: the CLA compiler cannot export a symbol the C28x linker resolves.
 *
 * Guarded on CPU1. The project builds every root-level source under both
 * configurations, and CPU2's CLA is reserved for the ADS131M08 current
 * control loop in a later phase of work.
 *
 * Copyright (C) 2026 - see repository licence.
 */

#ifdef CPU1

//
// A targeted include set, NOT driverlib.h.
//
// adc.h is CLA-safe: its includes stop at stdbool/stdint, inc/hw_adc.h,
// inc/hw_sysctl.h, inc/hw_memmap.h, inc/hw_types.h, cpu.h and debug.h. It
// never reaches sysctl.h or interrupt.h, neither of which compiles for the
// CLA. hw_types.h has an explicit __TMS320C28XX_CLA__ branch giving HWREGH a
// 16-bit-pointer definition, which is what ADC_readResult expands to; and
// ADC_readResult's ASSERT is a no-op unless DEBUG is defined, so the whole
// call inlines to a single HWREGH load.
//
// stdint.h first: hw_types.h typedefs uint8_t from uint16_t without ever
// defining uint16_t itself.
//
#include <stdint.h>
#include "inc/hw_types.h"
#include "inc/hw_memmap.h"
#include "adc.h"

#include "bts_cla_shared.h"

//
// Task 1 - filter one ADC sweep.
//
// The SOC-to-channel map below MIRRORS adcCellVoltageISR in bts_cpu1.c
// exactly, including the current reference subtraction. If a channel is ever
// re-pinned, both have to move together or the filtered telemetry silently
// reports a different slot than the control path does.
//
// Note the result BASE addresses: ADCxRESULT_BASE (0x0B00..0x0B60), not
// ADCx_BASE (0x7400..). Passing the peripheral base instead returns ADCCTL1 /
// ADCCTL2, which is where the constant 8320 (0x2080) in the ISR's history
// comment came from. All four result bases are inside the CLA's 16-bit
// address space; the peripheral bases are not.
//
__interrupt void Cla1Task1(void)
{
    float32_t vRaw[BTS_CLA_NUM_CH];
    float32_t iRaw[BTS_CLA_NUM_CH];
    float32_t refRaw;
    int16_t i;

    //
    // Cell voltages.
    //
    vRaw[0] = (float32_t)ADC_readResult(ADCARESULT_BASE, ADC_SOC_NUMBER0); // Ch1: A3
    vRaw[1] = (float32_t)ADC_readResult(ADCBRESULT_BASE, ADC_SOC_NUMBER0); // Ch2: B3
    vRaw[2] = (float32_t)ADC_readResult(ADCARESULT_BASE, ADC_SOC_NUMBER1); // Ch3: A5
    vRaw[3] = (float32_t)ADC_readResult(ADCARESULT_BASE, ADC_SOC_NUMBER2); // Ch4: IN15
    vRaw[4] = (float32_t)ADC_readResult(ADCDRESULT_BASE, ADC_SOC_NUMBER0); // Ch5: D1
    vRaw[5] = (float32_t)ADC_readResult(ADCCRESULT_BASE, ADC_SOC_NUMBER0); // Ch6: C3
    vRaw[6] = (float32_t)ADC_readResult(ADCDRESULT_BASE, ADC_SOC_NUMBER1); // Ch7: D3
    vRaw[7] = (float32_t)ADC_readResult(ADCCRESULT_BASE, ADC_SOC_NUMBER1); // Ch8: C5

    //
    // Cell currents.
    //
    iRaw[0] = (float32_t)ADC_readResult(ADCARESULT_BASE, ADC_SOC_NUMBER3); // Ch1: A2
    iRaw[1] = (float32_t)ADC_readResult(ADCBRESULT_BASE, ADC_SOC_NUMBER3); // Ch2: B2
    iRaw[2] = (float32_t)ADC_readResult(ADCARESULT_BASE, ADC_SOC_NUMBER4); // Ch3: A4
    iRaw[3] = (float32_t)ADC_readResult(ADCARESULT_BASE, ADC_SOC_NUMBER5); // Ch4: IN14
    iRaw[4] = (float32_t)ADC_readResult(ADCDRESULT_BASE, ADC_SOC_NUMBER2); // Ch5: D0
    iRaw[5] = (float32_t)ADC_readResult(ADCCRESULT_BASE, ADC_SOC_NUMBER2); // Ch6: C2
    iRaw[6] = (float32_t)ADC_readResult(ADCDRESULT_BASE, ADC_SOC_NUMBER3); // Ch7: D2
    iRaw[7] = (float32_t)ADC_readResult(ADCCRESULT_BASE, ADC_SOC_NUMBER3); // Ch8: C4

    //
    // The A0 reference. Cell current is differential about it, exactly as
    // adcCellVoltageISR computes iRaw[ch] - refRaw.
    //
    refRaw = (float32_t)ADC_readResult(ADCARESULT_BASE, ADC_SOC_NUMBER6);

    if (BTS_claPrimed == 0U)
    {
        //
        // First run: load the state rather than filter towards it from zero,
        // so telemetry does not ramp up over the first 12 ms of every boot.
        //
        for (i = 0; i < BTS_CLA_NUM_CH; i++)
        {
            BTS_claCellVoltageFilt[i] = vRaw[i];
            BTS_claCellCurrentFilt[i] = iRaw[i] - refRaw;
            BTS_claCellVoltageFast[i] = vRaw[i];
            BTS_claCellCurrentFast[i] = iRaw[i] - refRaw;
        }
        BTS_claPrimed = 1U;
    }
    else
    {
        //
        //   y += alpha * (x - y)
        //
        // TWO filters per channel, for two different consumers:
        //
        //   ...Filt  20 Hz, for telemetry. May lag; a host display does not
        //            care about 37 ms.
        //   ...Fast  the protection path's copy, tuned to match the settling
        //            of the 8-sample ring this replaced. The reverse polarity
        //            check, group supervision and the CV loop read this, and
        //            none of them may lag.
        //
        // Four multiply-accumulates per channel in float32. At 99.67 kSPS the
        // period is 10.03 us and the whole task - 17 ADC reads and 32 MACs -
        // is a small fraction of it, so there is no risk of overrunning the
        // next trigger. MSTF's overflow flag would show it if there were.
        //
        for (i = 0; i < BTS_CLA_NUM_CH; i++)
        {
            float32_t vNew = vRaw[i];
            float32_t iNew = iRaw[i] - refRaw;

            BTS_claCellVoltageFilt[i] +=
                BTS_CLA_ALPHA * (vNew - BTS_claCellVoltageFilt[i]);
            BTS_claCellCurrentFilt[i] +=
                BTS_CLA_ALPHA * (iNew - BTS_claCellCurrentFilt[i]);

            BTS_claCellVoltageFast[i] +=
                BTS_CLA_FAST_ALPHA * (vNew - BTS_claCellVoltageFast[i]);
            BTS_claCellCurrentFast[i] +=
                BTS_CLA_FAST_ALPHA * (iNew - BTS_claCellCurrentFast[i]);
        }
    }

    //
    // Liveness. C1() compares this against the value it saw on its PREVIOUS
    // pass - not against a fixed 100 ms, because the measured C1() rate is
    // 0.69 Hz rather than its nominal 10 Hz. If it has not moved, the
    // filtered telemetry falls back to the unfiltered value rather than
    // reporting a frozen reading as if it were live. 32-bit so it cannot wrap
    // onto the previous value between passes; see bts_cla_shared.h.
    //
    BTS_claRunCount++;
}

//
// Tasks 2-8 are unused. They are defined anyway because BTS_initCla() maps all
// eight MVECT registers - an unmapped vector left at its reset value would
// send the CLA off to fetch from wherever that happens to point if the task
// were ever triggered. Only task 1 is enabled in MIER, so these never run.
//
interrupt void Cla1Task2(void) { }
interrupt void Cla1Task3(void) { }
interrupt void Cla1Task4(void) { }
interrupt void Cla1Task5(void) { }
interrupt void Cla1Task6(void) { }
interrupt void Cla1Task7(void) { }
interrupt void Cla1Task8(void) { }

#endif /* CPU1 */
