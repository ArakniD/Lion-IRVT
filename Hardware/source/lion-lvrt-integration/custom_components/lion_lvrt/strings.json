{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Lion LVRT battery tester",
        "description": "Choose how Home Assistant reaches the tester. Bluetooth works through an ESPHome or Shelly Bluetooth proxy as well as a local adapter.",
        "data": {
          "transport": "Connection"
        }
      },
      "bluetooth_confirm": {
        "title": "Add {name}",
        "description": "Found {name} at {address}.\n\nOptionally add a CAN interface or the proxy's HTTP address. Either one grants register access, which is what enables direct charge and discharge commands on firmware whose BLE service has no register characteristic.",
        "data": {
          "slot_count": "Number of slots",
          "can_interface": "CAN interface (optional, e.g. can0)",
          "http_host": "HTTP address (optional, e.g. 192.168.1.50)"
        }
      },
      "ble": {
        "title": "Bluetooth connection",
        "description": "Enter the tester's Bluetooth address.",
        "data": {
          "address": "Bluetooth address",
          "slot_count": "Number of slots",
          "can_interface": "CAN interface (optional)",
          "http_host": "HTTP address (optional)"
        }
      },
      "can": {
        "title": "CAN connection",
        "description": "SocketCAN reaches the C2000 controller directly. Note that it does not reach the ESP32's test engine, so characterisation tests are unavailable on a CAN-only setup - charge, discharge and configuration all work.",
        "data": {
          "can_interface": "Interface",
          "can_bitrate": "Bit rate",
          "slot_count": "Number of slots"
        }
      },
      "http": {
        "title": "HTTP connection",
        "description": "The proxy's web API. Requires the tester to have joined a WiFi network.",
        "data": {
